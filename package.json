{
  "version": "1.0.0",
  "name": "@robertgregorywest/rob-west-gatsby",
  "description": "Portfolio website using Gatsby and Kontent headless CMS.",
  "repository": "git+https://github.com/robertgregorywest/rob-west-gatsby",
  "author": "Rob West <robertgregorywest@gmail.com> (https://github.com/robertgregorywest)",
  "license": "MIT",
  "private": false,
  "scripts": {
    "prepare": "node scripts/copy-env.js && husky",
    "develop": "gatsby develop",
    "build": "gatsby build",
    "clean": "gatsby clean",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '*.{js,ts,tsx,mts}' 'src/**/*.{ts,tsx}' 'e2e/**/*.ts'",
    "format:check": "prettier --check '*.{js,ts,tsx,mts}' 'src/**/*.{ts,tsx}' 'e2e/**/*.ts'",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "verify:build": "node scripts/verify-build.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "svgo": "^2.8.4",
    "joi": "^17.13.6",
    "multer": "^2.3.0",
    "decode-uri-component": "^0.5.0",
    "sharp": "^0.35.4",
    "postcss-modules-local-by-default": {
      "postcss-selector-parser": "^7.1.3"
    },
    "postcss-modules-scope": {
      "postcss-selector-parser": "^7.1.3"
    },
    "postcss-selector-parser": "^6.1.3",
    "postcss": "^8.5.23",
    "@ardatan/relay-compiler": {
      "immutable": "^4.3.9"
    },
    "axios": "^1.18.0",
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.6",
    "webpack": "^5.104.1",
    "ws": "^8.21.1",
    "cookie": "^0.7.2",
    "minimatch": "^3.1.3",
    "brace-expansion": "^1.1.16",
    "cosmiconfig": {
      "yaml": "^1.10.3"
    },
    "cssnano": {
      "yaml": "^1.10.3"
    },
    "immutable": "^5.1.8",
    "uuid": "^11.1.1",
    "resolve-url-loader": "^5.0.0",
    "lodash": "^4.18.1",
    "path-to-regexp": "^0.1.13"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@kontent-ai/gatsby-components": "^10.0.0",
    "@kontent-ai/gatsby-source": "^10.0.0",
    "gatsby-plugin-gtag": "^1.0.13",
    "gatsby-plugin-image": "^3.0.0",
    "gatsby-plugin-manifest": "^5.0.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-source-filesystem": "^5.0.0",
    "highlight.js": "^11.3.1",
    "highlightjs-cshtml-razor": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.45.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-preset-gatsby": "^3.16.0",
    "dotenv": "^18.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gatsby": "^5.16.1",
    "gatsby-cli": "^5.15.0",
    "gatsby-plugin-catch-links": "^5.0.0",
    "gatsby-plugin-sass": "^6.0.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "lost": "^9.0.2",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "lmdb": false,
    "@parcel/watcher": false,
    "core-js": false,
    "core-js-pure": false,
    "es5-ext": false,
    "gatsby": false,
    "gatsby-cli": false,
    "msgpackr-extract": false
  }
}
